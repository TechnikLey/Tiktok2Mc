# See defaults/gifts.json for all gift IDs and names.
# Semicolon (;) chains multiple commands: runs /give first, then the >> overlay.
# & runs a shell command on your PC (e.g. URL call, custom script).
follow:/give @a minecraft:golden_apple 7 ; >>New Follower!|{user} is now following!|5
# Caution: avoid expensive or spammy commands here (they may lag the stream).
#join:>>Welcome!|{user} joined the stream!
# Caution: avoid expensive or spammy commands here (they may lag the stream).
#comment:>>{user} wrote:|{comment}
# "likes" fires every N likes (default: 100, configurable in config.yaml).
likes:/execute at @a run summon minecraft:creeper ~ ~ ~ x2
# "like_2" fires at a larger milestone (default: 100,000 likes).
# Semicolon (;) chains both commands: /clear runs first, then /kill.
like_2:/clear @a * ; /kill @a
# ─── Rose (Gift ID: 655) ──────────────────────────────────────────────────
# Parameters: !tnt <Amount> <Delay> <Fuse> <Player>
5655:!tnt 2 0.1 2 Notch
# ─── Mamma Mia (Gift ID: 6111) ─────────────────────────────────────────────
16111:/give @a minecraft:diamond
# ─── Rosa (Gift ID: 913) ──────────────────────────────────────────────────
8913:/execute at @a run summon minecraft:evoker ~ ~ ~ x3
# ─── Corgi (Gift ID: 267) ─────────────────────────────────────────────────
# Same syntax as above: !tnt <Amount> <Delay> <Fuse> <Player>
6267:!tnt 600 0.1 2 Notch
# ─── Money Gun (Gift ID: 168) ──────────────────────────────────────────────
7168:/execute at @a run summon minecraft:wither ~ ~ ~ x50
# ─── Flower Show (Gift ID: 6071) ───────────────────────────────────────────
# $random picks a random active trigger (defaults: likes, like_2, follow, join, comment).
16071:$random
'Tom the Tomato':$random
16379:$random