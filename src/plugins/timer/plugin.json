{
  "name": "timer",
  "version": "1.0.0",
  "entry_point": "src/plugins/timer/main.py",
  "display_name": "Timer",
  "description": "A configurable count-up / count-down timer overlay. Publishes lifecycle events to the EventBus so hooks and other plugins can react without hardcoded coupling.",
  "author": "TechnikLey",
  "homepage": "https://github.com/TechnikLey/Tiktok2Mc",
  "min_api_version": "1.0.0",
  "bundled": true,
  "platform": "all",
  "capabilities": [
    "timer:schedule",
    "timer:pause",
    "timer:reset",
    "timer:status",
    "timer:events"
  ],
  "permissions": ["events"],
  "depends_on": [],
  "icon": "⏱️",
  "emitted_events": [
    {
      "key": "timer.started",
      "name": "Timer Starts",
      "desc": "When the countdown timer starts",
      "icon": "▶️",
      "name_i18n": { "en": "Timer Starts", "de": "Timer gestartet" },
      "desc_i18n": { "en": "When the countdown timer starts", "de": "Wenn der Countdown-Timer startet" }
    },
    {
      "key": "timer.paused",
      "name": "Timer Pauses",
      "desc": "When the countdown timer is paused",
      "icon": "⏸️",
      "name_i18n": { "en": "Timer Pauses", "de": "Timer pausiert" },
      "desc_i18n": { "en": "When the countdown timer is paused", "de": "Wenn der Countdown-Timer pausiert wird" }
    },
    {
      "key": "timer.resumed",
      "name": "Timer Resumes",
      "desc": "When the countdown timer resumes",
      "icon": "▶️",
      "name_i18n": { "en": "Timer Resumes", "de": "Timer fortgesetzt" },
      "desc_i18n": { "en": "When the countdown timer resumes", "de": "Wenn der Countdown-Timer fortgesetzt wird" }
    },
    {
      "key": "timer.reset",
      "name": "Timer Resets",
      "desc": "When the countdown timer is reset",
      "icon": "🔄",
      "name_i18n": { "en": "Timer Resets", "de": "Timer zurückgesetzt" },
      "desc_i18n": { "en": "When the countdown timer is reset", "de": "Wenn der Countdown-Timer zurückgesetzt wird" }
    },
    {
      "key": "timer.tick",
      "name": "Timer Ticks",
      "desc": "Every second while the timer is running",
      "icon": "⏱️",
      "name_i18n": { "en": "Timer Ticks", "de": "Timer-Tick" },
      "desc_i18n": { "en": "Every second while the timer is running", "de": "Jede Sekunde solange der Timer läuft" }
    },
    {
      "key": "timer.zero",
      "name": "Timer Hits Zero",
      "desc": "When the countdown reaches zero",
      "icon": "⏰",
      "name_i18n": { "en": "Timer Hits Zero", "de": "Timer erreicht Null" },
      "desc_i18n": { "en": "When the countdown reaches zero", "de": "Wenn der Countdown Null erreicht" }
    },
    {
      "key": "timer.milestone",
      "name": "Timer Milestone",
      "desc": "When the timer passes a configured milestone",
      "icon": "🎯",
      "name_i18n": { "en": "Timer Milestone", "de": "Timer-Meilenstein" },
      "desc_i18n": { "en": "When the timer passes a configured milestone", "de": "Wenn der Timer einen konfigurierten Meilenstein überschreitet" }
    }
  ],
  "accepted_commands": {
    "start": {
      "name": "Start Timer",
      "desc": "Begin the countdown from the current time",
      "args": {},
      "name_i18n": { "en": "Start Timer", "de": "Timer starten" },
      "desc_i18n": { "en": "Begin the countdown from the current time", "de": "Countdown ab der aktuellen Zeit beginnen" }
    },
    "pause": {
      "name": "Pause Timer",
      "desc": "Pause the countdown",
      "args": {},
      "name_i18n": { "en": "Pause Timer", "de": "Timer pausieren" },
      "desc_i18n": { "en": "Pause the countdown", "de": "Countdown pausieren" }
    },
    "resume": {
      "name": "Resume Timer",
      "desc": "Continue a paused countdown",
      "args": {},
      "name_i18n": { "en": "Resume Timer", "de": "Timer fortsetzen" },
      "desc_i18n": { "en": "Continue a paused countdown", "de": "Pausierten Countdown fortsetzen" }
    },
    "reset": {
      "name": "Reset Timer",
      "desc": "Reset the timer to its starting value",
      "args": {},
      "name_i18n": { "en": "Reset Timer", "de": "Timer zurücksetzen" },
      "desc_i18n": { "en": "Reset the timer to its starting value", "de": "Timer auf Ausgangswert zurücksetzen" }
    },
    "add_time": {
      "name": "Add Time",
      "desc": "Add seconds to the current timer",
      "args": {
        "seconds": {
          "type": "number",
          "label": "Seconds to add",
          "default": 10,
          "min": 1,
          "label_i18n": { "en": "Seconds to add", "de": "Sekunden hinzufügen" }
        }
      },
      "name_i18n": { "en": "Add Time", "de": "Zeit hinzufügen" },
      "desc_i18n": { "en": "Add seconds to the current timer", "de": "Sekunden zum aktuellen Timer hinzufügen" }
    },
    "set_time": {
      "name": "Set Time",
      "desc": "Set the timer to a specific number of seconds",
      "args": {
        "seconds": {
          "type": "number",
          "label": "Seconds to set",
          "default": 60,
          "min": 0,
          "label_i18n": { "en": "Seconds to set", "de": "Sekunden einstellen" }
        }
      },
      "name_i18n": { "en": "Set Time", "de": "Zeit einstellen" },
      "desc_i18n": { "en": "Set the timer to a specific number of seconds", "de": "Timer auf eine bestimmte Anzahl Sekunden setzen" }
    }
  },
  "update_url": "https://api.github.com/repos/TechnikLey/Tiktok2Mc/releases/latest",
  "config_schema": {
    "version": 1,
    "fields": [
      {
        "key": "direction",
        "type": "select",
        "options": [
          "down",
          "up"
        ],
        "default": "down",
        "label": "Direction",
        "help": "Count down from start_time or count up from zero",
        "category": "Timer"
      },
      {
        "key": "start_time",
        "type": "integer",
        "default": 600,
        "min": 1,
        "label": "Start Time (seconds)",
        "help": "Initial time in seconds. For direction=down this is the countdown start; for up this is the maximum (used with loop/stop logic).",
        "category": "Timer"
      },
      {
        "key": "time_step",
        "type": "integer",
        "default": 1,
        "min": 1,
        "max": 60,
        "label": "Time Step (seconds)",
        "help": "How many seconds to add/remove per tick",
        "category": "Timer"
      },
      {
        "key": "auto_start",
        "type": "boolean",
        "default": false,
        "label": "Auto Start",
        "help": "Start the timer automatically when the plugin loads",
        "category": "Timer"
      },
      {
        "key": "loop",
        "type": "boolean",
        "default": false,
        "label": "Loop",
        "help": "When counting down and reaching zero, automatically reset to start_time instead of pausing",
        "category": "Timer"
      },
      {
        "key": "reset_on",
        "type": "array",
        "default": [
          "zero"
        ],
        "item_schema": {
          "type": "select",
          "options": [
            "zero",
            "manual",
            "command"
          ]
        },
        "label": "Reset On",
        "help": "Events that trigger an automatic reset: zero = timer hits zero; manual = reset command; command = any set_time/add_time command",
        "advanced": true,
        "category": "Timer"
      },
      {
        "key": "signal_on",
        "type": "array",
        "default": [
          "zero",
          "started",
          "paused",
          "reset"
        ],
        "item_schema": {
          "type": "select",
          "options": [
            "started",
            "paused",
            "resumed",
            "reset",
            "tick",
            "zero",
            "milestone"
          ]
        },
        "label": "Signal On",
        "help": "Timer events published to the EventBus via POST /api/v1/events. Consumers (hooks, other plugins) can subscribe without coupling.",
        "advanced": true,
        "category": "Events"
      },
      {
        "key": "milestones",
        "type": "array",
        "default": [],
        "item_schema": {
          "type": "integer",
          "min": 0
        },
        "label": "Milestones (seconds)",
        "help": "List of times (seconds) at which a timer.milestone event is emitted. Count-down triggers at or below; count-up triggers at or above.",
        "advanced": true,
        "category": "Events"
      },
      {
        "key": "format",
        "type": "select",
        "options": [
          "mm:ss",
          "hh:mm:ss",
          "seconds"
        ],
        "default": "mm:ss",
        "label": "Display Format",
        "help": "Overlay time display format",
        "category": "Appearance"
      },
      {
        "key": "theme.background",
        "type": "color",
        "default": "#000000",
        "label": "Background Color",
        "category": "Theme"
      },
      {
        "key": "theme.text",
        "type": "color",
        "default": "#89CFF0",
        "label": "Text Color",
        "category": "Theme"
      },
      {
        "key": "theme.warning",
        "type": "color",
        "default": "#FFD700",
        "label": "Warning Color",
        "category": "Theme"
      },
      {
        "key": "theme.blink",
        "type": "color",
        "default": "#FF8C00",
        "label": "Blink Color",
        "category": "Theme"
      },
      {
        "key": "theme.danger",
        "type": "color",
        "default": "#FF0000",
        "label": "Danger Color",
        "category": "Theme"
      }
    ]
  }
}
