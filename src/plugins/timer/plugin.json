{
  "name": "timer",
  "version": "1.0.0",
  "entry_point": "src/plugins/timer/main.py",
  "display_name": "Timer",
  "description": "A configurable countdown timer overlay. Can pause on player death, auto-post wins to Win Counter, and be controlled via REST endpoints.",
  "author": "TechnikLey",
  "homepage": "https://github.com/TechnikLey/Tiktok2Mc",
  "ports": {
    "declared": [
      29189
    ],
    "protocol": "tcp"
  },
  "min_api_version": "1.0.0",
  "capabilities": [
    "timer:schedule",
    "timer:pause",
    "timer:reset",
    "timer:status"
  ],
  "depends_on": [],
  "auto_enable": false,
  "update_url": "https://api.github.com/repos/TechnikLey/Tiktok2Mc/releases/latest",
  "config_schema": {
    "version": 1,
    "fields": [
      {
        "key": "enabled",
        "type": "boolean",
        "default": false,
        "label": "Enable Plugin",
        "help": "Turn the countdown timer on or off",
        "category": "General"
      },
      {
        "key": "port",
        "type": "integer",
        "default": 29189,
        "min": 1024,
        "max": 65535,
        "label": "Port",
        "help": "Web server and overlay port",
        "category": "General"
      },
      {
        "key": "start_time",
        "type": "integer",
        "default": 10,
        "min": 1,
        "label": "Start Time (minutes)",
        "help": "Initial countdown duration in minutes",
        "category": "Timer"
      },
      {
        "key": "auto_win",
        "type": "boolean",
        "default": false,
        "label": "Auto Win",
        "help": "Post a win to Win Counter when the timer reaches zero",
        "category": "Coupling"
      },
      {
        "key": "pause_on_death",
        "type": "boolean",
        "default": false,
        "label": "Pause on Death",
        "help": "Pause and reset the timer when the player dies",
        "category": "Coupling"
      },
      {
        "key": "win_counter_port",
        "type": "integer",
        "default": 29191,
        "min": 1024,
        "max": 65535,
        "label": "Win Counter Port",
        "help": "Port of the Win Counter plugin (used when Auto Win is enabled)",
        "category": "Coupling"
      },
      {
        "key": "theme.background",
        "type": "color",
        "default": "#000000",
        "label": "Background Color",
        "category": "Theme"
      },
      {
        "key": "theme.text",
        "type": "color",
        "default": "#89CFF0",
        "label": "Text Color",
        "category": "Theme"
      },
      {
        "key": "theme.warning",
        "type": "color",
        "default": "#FFD700",
        "label": "Warning Color",
        "category": "Theme"
      },
      {
        "key": "theme.blink",
        "type": "color",
        "default": "#FF8C00",
        "label": "Blink Color",
        "category": "Theme"
      },
      {
        "key": "theme.danger",
        "type": "color",
        "default": "#FF0000",
        "label": "Danger Color",
        "category": "Theme"
      }
    ]
  }
}
