{
  "name": "channel-points",
  "version": "1.0.0",
  "entry_point": "src/plugins/channelpoints/main.py",
  "display_name": "Channel Points",
  "description": "Awards loyalty points to active viewers. Viewers earn points over time and can spend them on rewards.",
  "author": "TechnikLey",
  "homepage": "https://github.com/TechnikLey/Tiktok2Mc",
  "min_api_version": "1.0.0",
  "capabilities": [
    "channel_points:reward",
    "channel_points:balance",
    "channel_points:leaderboard"
  ],
  "depends_on": [],
  "auto_enable": false,
  "update_url": "https://api.github.com/repos/TechnikLey/Tiktok2Mc/releases/latest",
  "config_schema": {
    "version": 1,
    "fields": [
      {
        "key": "award_amount",
        "type": "integer",
        "default": 10,
        "min": 1,
        "label": "Award Amount",
        "help": "Points awarded per interval to each active viewer",
        "category": "Rewards"
      },
      {
        "key": "award_interval_seconds",
        "type": "integer",
        "default": 60,
        "min": 1,
        "label": "Award Interval (seconds)",
        "help": "How often points are awarded",
        "category": "Rewards"
      },
      {
        "key": "ping_timeout_minutes",
        "type": "integer",
        "default": 10,
        "min": 1,
        "label": "Ping Timeout (minutes)",
        "help": "Minutes after last activity before a viewer is considered inactive",
        "category": "Rewards"
      },
      {
        "key": "leaderboard_count",
        "type": "integer",
        "default": 10,
        "min": 1,
        "max": 100,
        "label": "Leaderboard Count",
        "help": "Number of top viewers shown on the leaderboard overlay",
        "category": "Rewards"
      },
      {
        "key": "theme.background",
        "type": "color",
        "default": "#000000",
        "label": "Background Color",
        "category": "Theme"
      },
      {
        "key": "theme.text",
        "type": "color",
        "default": "#ffffff",
        "label": "Text Color",
        "category": "Theme"
      },
      {
        "key": "theme.accent",
        "type": "color",
        "default": "#FFD700",
        "label": "Accent Color",
        "category": "Theme"
      },
      {
        "key": "theme.accent2",
        "type": "color",
        "default": "#00BFFF",
        "label": "Accent 2 Color",
        "category": "Theme"
      },
      {
        "key": "theme.accent3",
        "type": "color",
        "default": "#40E0D0",
        "label": "Accent 3 Color",
        "category": "Theme"
      },
      {
        "key": "theme.danger",
        "type": "color",
        "default": "#FF4500",
        "label": "Danger Color",
        "category": "Theme"
      }
    ]
  }
}
