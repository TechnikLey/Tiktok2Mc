{
  "name": "death-counter",
  "version": "1.0.0",
  "entry_point": "src/plugins/deathcounter/main.py",
  "display_name": "Death Counter",
  "description": "Counts player deaths with configurable milestones. Publishes death.milestone events to the EventBus so consumers can react without coupling.",
  "author": "TechnikLey",
  "homepage": "https://github.com/TechnikLey/Tiktok2Mc",
  "min_api_version": "1.0.0",
  "bundled": true,
  "platform": "all",
  "dashboard_ui": true,
  "queries": [
    "deaths"
  ],
  "capabilities": [
    "death-counter:count",
    "death-counter:milestones",
    "death-counter:events"
  ],
  "permissions": [
    "events"
  ],
  "depends_on": [],
  "icon": "💀",
  "emitted_events": [
    {
      "key": "death.milestone",
      "name": "Death Milestone Reached",
      "desc": "When the death count reaches a configured milestone",
      "icon": "💀",
      "name_i18n": {
        "en": "Death Milestone Reached",
        "de": "Todes-Meilenstein erreicht"
      },
      "desc_i18n": {
        "en": "When the death count reaches a configured milestone",
        "de": "Wenn die Todesanzahl einen konfigurierten Meilenstein erreicht"
      },
      "version": 1,
      "data_schema": [
        {
          "key": "deaths",
          "type": "number",
          "required": true,
          "desc": "Death count that reached the milestone"
        },
        {
          "key": "needed",
          "type": "number",
          "desc": "Wins needed for the next milestone"
        }
      ]
    }
  ],
  "accepted_commands": {
    "player_death": {
      "name": "Count Death",
      "desc": "Increase the death counter",
      "args": {},
      "name_i18n": {
        "en": "Count Death",
        "de": "Tod zählen"
      },
      "desc_i18n": {
        "en": "Increase the death counter",
        "de": "Todeszähler erhöhen"
      }
    },
    "add_death": {
      "name": "Add Deaths",
      "desc": "Add deaths to the counter",
      "args": {
        "amount": {
          "type": "number",
          "label": "How many deaths",
          "default": 1,
          "min": 1,
          "label_i18n": {
            "en": "How many deaths",
            "de": "Wie viele Tode"
          }
        }
      },
      "name_i18n": {
        "en": "Add Deaths",
        "de": "Tode hinzufügen"
      },
      "desc_i18n": {
        "en": "Add deaths to the counter",
        "de": "Tode zum Zähler hinzufügen"
      }
    },
    "reset": {
      "name": "Reset Counter",
      "desc": "Reset the death counter to zero",
      "args": {},
      "name_i18n": {
        "en": "Reset Counter",
        "de": "Zähler zurücksetzen"
      },
      "desc_i18n": {
        "en": "Reset the death counter to zero",
        "de": "Todeszähler auf Null zurücksetzen"
      }
    }
  },
  "update_url": "https://api.github.com/repos/TechnikLey/Tiktok2Mc/releases/latest",
  "config_schema": {
    "version": 1,
    "fields": [
      {
        "key": "milestones",
        "type": "array",
        "default": [],
        "item_schema": {
          "type": "integer",
          "min": 1
        },
        "label": "Milestones",
        "help": "Death counts at which a death.milestone event is emitted",
        "category": "Events"
      },
      {
        "key": "signal_on",
        "type": "array",
        "default": [
          "milestone"
        ],
        "item_schema": {
          "type": "select",
          "options": [
            "milestone"
          ]
        },
        "label": "Signal On",
        "help": "Events published to the EventBus via POST /api/v1/events",
        "advanced": true,
        "category": "Events"
      },
      {
        "key": "theme.background",
        "type": "color",
        "default": "#000000",
        "label": "Background Color",
        "category": "Theme"
      },
      {
        "key": "theme.text",
        "type": "color",
        "default": "#ff4444",
        "label": "Text Color",
        "category": "Theme"
      },
      {
        "key": "theme.accent",
        "type": "color",
        "default": "#ff8888",
        "label": "Accent Color",
        "category": "Theme"
      }
    ]
  }
}
