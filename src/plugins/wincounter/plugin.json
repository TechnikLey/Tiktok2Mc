{
  "name": "win-counter",
  "version": "1.0.0",
  "entry_point": "src/plugins/wincounter/main.py",
  "display_name": "Win Counter",
  "description": "Tracks wins and losses with optional death decrement from Minecraft. Wins escalate the target automatically when reached.",
  "author": "TechnikLey",
  "homepage": "https://github.com/TechnikLey/Tiktok2Mc",
  "min_api_version": "1.0.0",
  "capabilities": [
    "win_counter:track",
    "win_counter:webhook",
    "win_counter:escalation"
  ],
  "depends_on": [],
  "auto_enable": false,
  "update_url": "https://api.github.com/repos/TechnikLey/Tiktok2Mc/releases/latest",
  "config_schema": {
    "version": 1,
    "fields": [
      {
        "key": "decrement_on_death",
        "type": "boolean",
        "default": false,
        "label": "Decrement on Death",
        "help": "Remove a win when the player dies (requires MinecraftServerAPI)",
        "category": "Behavior"
      },
      {
        "key": "theme.background",
        "type": "color",
        "default": "#000000",
        "label": "Background Color",
        "category": "Theme"
      },
      {
        "key": "theme.text",
        "type": "color",
        "default": "#ffffff",
        "label": "Text Color",
        "category": "Theme"
      },
      {
        "key": "theme.danger",
        "type": "color",
        "default": "#ff4d4d",
        "label": "Danger Color",
        "category": "Theme"
      },
      {
        "key": "theme.muted",
        "type": "color",
        "default": "#666666",
        "label": "Muted Color",
        "category": "Theme"
      },
      {
        "key": "theme.separator",
        "type": "color",
        "default": "#333333",
        "label": "Separator Color",
        "category": "Theme"
      }
    ]
  }
}
