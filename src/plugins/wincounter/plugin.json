{
  "name": "win-counter",
  "version": "1.0.0",
  "entry_point": "src/plugins/wincounter/main.py",
  "display_name": "Win Counter",
  "description": "Counts wins with configurable milestones. Publishes win.milestone and win.record_low events to the EventBus so consumers can react without coupling.",
  "author": "TechnikLey",
  "homepage": "https://github.com/TechnikLey/Tiktok2Mc",
  "min_api_version": "1.0.0",
  "capabilities": [
    "win-counter:count",
    "win-counter:milestones",
    "win-counter:events"
  ],
  "depends_on": [],
  "icon": "🏆",
  "emitted_events": [
    { "key": "win.milestone", "name": "Win Milestone Reached", "desc": "When the win count reaches a configured milestone", "category": "custom", "icon": "🏆" },
    { "key": "win.record_low", "name": "New Record Low", "desc": "When the win count drops to a new record low", "category": "custom", "icon": "📉" }
  ],
  "accepted_commands": {
    "add_win": { "name": "Add Win", "desc": "Increase the win count", "args": { "amount": { "type": "number", "label": "How many wins", "default": 1, "min": 1 } } },
    "remove_win": { "name": "Remove Win", "desc": "Decrease the win count", "args": { "amount": { "type": "number", "label": "How many to remove", "default": 1, "min": 1 } } }
  },
  "update_url": "https://api.github.com/repos/TechnikLey/Tiktok2Mc/releases/latest",
  "config_schema": {
    "version": 1,
    "fields": [
      {
        "key": "initial_needed",
        "type": "integer",
        "default": 10,
        "min": 1,
        "label": "Initial Needed",
        "help": "Wins required for the first milestone",
        "category": "Goals"
      },
      {
        "key": "milestone_increment",
        "type": "integer",
        "default": 10,
        "min": 1,
        "label": "Milestone Increment",
        "help": "Additional wins needed for each next milestone",
        "category": "Goals"
      },
      {
        "key": "signal_on",
        "type": "array",
        "default": ["milestone", "record_low"],
        "item_schema": {
          "type": "select",
          "options": ["milestone", "record_low"]
        },
        "label": "Signal On",
        "help": "Events published to the EventBus via POST /api/v1/events",
        "advanced": true,
        "category": "Events"
      },
      {
        "key": "theme.background",
        "type": "color",
        "default": "#000000",
        "label": "Background Color",
        "category": "Theme"
      },
      {
        "key": "theme.text",
        "type": "color",
        "default": "#ffffff",
        "label": "Text Color",
        "category": "Theme"
      },
      {
        "key": "theme.muted",
        "type": "color",
        "default": "#aaaaaa",
        "label": "Muted Color",
        "category": "Theme"
      },
      {
        "key": "theme.danger",
        "type": "color",
        "default": "#ff4444",
        "label": "Danger Color",
        "category": "Theme"
      },
      {
        "key": "theme.separator",
        "type": "color",
        "default": "#444444",
        "label": "Separator Color",
        "category": "Theme"
      }
    ]
  }
}
