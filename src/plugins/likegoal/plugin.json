{
  "name": "like-goal",
  "version": "1.0.0",
  "entry_point": "src/plugins/likegoal/main.py",
  "display_name": "Like Goal",
  "description": "Displays a progress bar that fills as the stream accumulates likes. Supports multiple goal modes (reset, step, multiply).",
  "author": "TechnikLey",
  "homepage": "https://github.com/TechnikLey/Tiktok2Mc",
  "ports": {
    "declared": [
      29193
    ],
    "protocol": "tcp"
  },
  "min_api_version": "1.0.0",
  "capabilities": [
    "like_goal:progress",
    "like_goal:reset",
    "like_goal:status"
  ],
  "depends_on": [],
  "auto_enable": false,
  "update_url": "https://api.github.com/repos/TechnikLey/Tiktok2Mc/releases/latest",
  "config_schema": {
    "version": 1,
    "fields": [
      {
        "key": "enabled",
        "type": "boolean",
        "default": false,
        "label": "Enable Plugin",
        "help": "Turn the Like Goal overlay on or off",
        "category": "General"
      },
      {
        "key": "port",
        "type": "integer",
        "default": 29193,
        "min": 1024,
        "max": 65535,
        "label": "Port",
        "help": "Web server and overlay port",
        "category": "General"
      },
      {
        "key": "display_text",
        "type": "string",
        "default": "Like Goal",
        "label": "Display Text",
        "help": "Text shown above the progress bar",
        "category": "Appearance"
      },
      {
        "key": "initial_goal",
        "type": "integer",
        "default": 100000,
        "min": 1,
        "label": "Initial Goal",
        "help": "Number of likes needed to reach the first goal",
        "category": "Goals"
      },
      {
        "key": "goal_multiplier",
        "type": "integer",
        "default": 1,
        "min": 0,
        "label": "Goal Multiplier",
        "help": "0=reset, 1=step, 2+=multiply",
        "category": "Goals"
      },
      {
        "key": "triggers",
        "type": "array",
        "default": [
          {
            "id": "likes_standard",
            "every": 100,
            "function": "likes",
            "payload": "Community",
            "enabled": true
          },
          {
            "id": "likes_100k",
            "every": 100000,
            "function": "like_2",
            "payload": "Community",
            "enabled": true
          }
        ],
        "item_schema": {
          "type": "object",
          "fields": [
            {"key": "id", "type": "string", "default": ""},
            {"key": "every", "type": "integer", "default": 100, "min": 1},
            {"key": "function", "type": "string", "default": ""},
            {"key": "payload", "type": "string", "default": "Community"},
            {"key": "enabled", "type": "boolean", "default": true}
          ]
        },
        "label": "Like Triggers",
        "category": "Triggers"
      },
      {
        "key": "theme.background",
        "type": "color",
        "default": "#050505",
        "label": "Background Color",
        "category": "Theme"
      },
      {
        "key": "theme.text",
        "type": "color",
        "default": "#ffffff",
        "label": "Text Color",
        "category": "Theme"
      },
      {
        "key": "theme.accent",
        "type": "color",
        "default": "#00f5ff",
        "label": "Accent Color",
        "category": "Theme"
      },
      {
        "key": "theme.accent2",
        "type": "color",
        "default": "#8a2be2",
        "label": "Accent 2 Color",
        "category": "Theme"
      },
      {
        "key": "theme.danger",
        "type": "color",
        "default": "#ff4d4d",
        "label": "Danger Color",
        "category": "Theme"
      }
    ]
  }
}
